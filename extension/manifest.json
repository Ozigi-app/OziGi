{
  "manifest_version": 3,
  "name": "Ozigi LinkedIn Sender",
  "version": "0.1.0",
  "description": "Sends your Ozigi-queued LinkedIn connection requests and messages from your own browser, at a human pace.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "debugger"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://ozigi.app/*",
    "https://*.ozigi.app/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ozigi LinkedIn Sender"
  }
}
